# linkorder — profil M (serwer klasy vroot_JUMP: 8 vCPU, 12 GB RAM; do ok. 30 tys. zamówień miesięcznie).
# Podpisywany w wydaniu jako releases/<wersja>/profile-m.env; instalator podaje go do compose przed
# /etc/linkorder/compose.env. Tylko limity i rozmiary pul — żadnych sekretów i żadnych nazw hostów.
# Widełki dopuszczalnych wartości sprawdza polityka instalatora (deploy/compose/README.md).
LINKORDER_PROFILE=m

# Limity pamięci kontenerów (twarde; swap wyłączony — memswap_limit = mem_limit).
LINKORDER_MEM_EDGE=64m
LINKORDER_MEM_WEB_PANEL=768m
LINKORDER_MEM_WORKER=768m
LINKORDER_MEM_WORKER_BULK=384m
LINKORDER_MEM_RELAY=192m
LINKORDER_MEM_SCHEDULER=256m
LINKORDER_MEM_MIGRATE=768m
LINKORDER_MEM_CLI=256m
LINKORDER_MEM_VALKEY_CORE=512m
LINKORDER_MEM_VALKEY_CACHE=200m
LINKORDER_MEM_EGRESS=64m
# Runda 12 (ADR-045): API v1, powiadomienia wychodzące, dekodowanie obrazów i PDF.
LINKORDER_MEM_WEB_API=512m
LINKORDER_MEM_WEBHOOKS_OUT=192m
LINKORDER_MEM_WEB_HOOKS=256m
LINKORDER_MEM_MEDIA=512m
LINKORDER_MEM_MAILER=192m

# Pule PHP-FPM (procesy statyczne).
LINKORDER_FPM_PANEL_CHILDREN=10
LINKORDER_FPM_HOOKS_CHILDREN=4
LINKORDER_FPM_API_CHILDREN=4

# Valkey: maxmemory (core — noeviction; cache — allkeys-lru).
LINKORDER_VALKEY_CORE_MAXMEMORY=256mb
LINKORDER_VALKEY_CACHE_MAXMEMORY=128mb

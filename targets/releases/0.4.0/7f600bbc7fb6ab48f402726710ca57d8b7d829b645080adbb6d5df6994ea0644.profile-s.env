# linkorder — profil S (minimum: 4 vCPU, 8 GB RAM, 80 GB dysku; do ok. 3 tys. zamówień miesięcznie — ADR-020).
# Podpisywany w wydaniu jako releases/<wersja>/profile-s.env; instalator podaje go do compose przed
# /etc/linkorder/compose.env. Tylko limity i rozmiary pul — żadnych sekretów i żadnych nazw hostów.
# Widełki dopuszczalnych wartości sprawdza polityka instalatora (deploy/compose/README.md).
LINKORDER_PROFILE=s

LINKORDER_MEM_EDGE=64m
LINKORDER_MEM_WEB_PANEL=512m
LINKORDER_MEM_WORKER=448m
LINKORDER_MEM_WORKER_BULK=320m
LINKORDER_MEM_RELAY=160m
LINKORDER_MEM_SCHEDULER=224m
LINKORDER_MEM_MIGRATE=512m
LINKORDER_MEM_CLI=256m
LINKORDER_MEM_VALKEY_CORE=384m
LINKORDER_MEM_VALKEY_CACHE=160m
LINKORDER_MEM_EGRESS=64m
# Runda 12 (ADR-045): API v1, powiadomienia wychodzące, dekodowanie obrazów i PDF.
LINKORDER_MEM_WEB_API=384m
LINKORDER_MEM_WEBHOOKS_OUT=160m
LINKORDER_MEM_WEB_HOOKS=192m
LINKORDER_MEM_MEDIA=384m

LINKORDER_FPM_PANEL_CHILDREN=6
LINKORDER_FPM_HOOKS_CHILDREN=3
LINKORDER_FPM_API_CHILDREN=3

LINKORDER_VALKEY_CORE_MAXMEMORY=192mb
LINKORDER_VALKEY_CACHE_MAXMEMORY=96mb
